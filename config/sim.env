# config/sim.env -- SIMULATION environment. Source it, never execute it.
#
#   source "$VLA_ROOT/config/sim.env"
#
# Replaces the variable half of sim_mode.sh. Sets variables ONLY -- no
# shared-memory clean, no ROS daemon restart, no banner. For an interactive
# terminal use `source scripts/vla_mode.sh sim`, which does those too.
#
# Simulation and hardware need OPPOSITE settings and each fails SILENTLY under
# the other's. The failure mode is worth knowing because it cost an hour: with
# the hardware discovery-server variables still set and the robot switched off,
# Gazebo loads the world, the robot never spawns, and the log just repeats
# "Waiting messages on topic [robot_description]" forever, with no error.

# shellcheck source=./paths.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/paths.sh"

# `|| true` so a missing ROS install cannot abort a caller that uses `set -e`
# (the Makefile and the container entrypoints do). The warning still prints.
vla_ros_setup || true

# ---- isolation is NOT done with the domain ----------------------------------
unset ROS_DOMAIN_ID
# Domain 42 was tried and REJECTED (handout §5.1): gz_ros2_control runs INSIDE
# the Gazebo process and does not inherit the domain, so controller_manager came
# up on 0 while the spawner looked for it on 42 -- the robot spawned and could
# not move. The domain is left at the default.
#
# Isolation comes instead from the two unsets below, the mode lock
# (/tmp/vla_mode.lock) that stops both modes running at once, and separate GUI
# configs. The problem that needs solving is real and was observed:
# /robot1/oakd/... topics from a morning hardware session were still visible in
# the afternoon's simulation, and the agent bound to them instead of the
# simulated camera.

unset FASTRTPS_DEFAULT_PROFILES_FILE
# The super-client XML points Fast DDS at the robot's discovery server.

unset ROS_DISCOVERY_SERVER
# Unreachable when the robot is off -- and it fails silently, see above.

# ---- project ----------------------------------------------------------------
export VLA_NS=""
# EMPTY, not unset. The agent reads os.environ.get("VLA_NS", "/robot1"), so
# UNSETTING it hands back the /robot1 default -- the exact opposite of what is
# wanted here. The simulation publishes bare /scan, /odom, /cmd_vel.

export VLA_RAW_RGB=1
# Turn OFF compressed RGB (#50). Gazebo publishes plain sensor_msgs/Image and
# the /compressed topic does not exist, so the agent would subscribe to nothing
# and report "I see: nothing" while the camera ran perfectly.

export VLA_RAW_DEPTH=1
# Same for compressedDepth (#51). Both transports exist only to survive the
# Wi-Fi link, which the simulation does not have.
