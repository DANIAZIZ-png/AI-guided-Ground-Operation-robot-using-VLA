# config/robot.env -- HARDWARE environment. Source it, never execute it.
#
#   source "$VLA_ROOT/config/robot.env"
#
# Replaces the old robot_env.sh and the variable half of robot_mode.sh, and the
# ROS/DDS block that used to sit in ~/.bashrc lines 118-130 (kept verbatim in
# env/bashrc_lines_118-130.txt).
#
# This file sets variables ONLY. No shared-memory clean, no ROS daemon restart,
# no banner -- so it is safe inside scripts, `xterm -e` launchers and `bash -c`
# wrappers. For an interactive terminal use `source scripts/vla_mode.sh robot`,
# which sources this file and then does the side effects.
#
# WHY THE SIDE EFFECTS ARE SEPARATE: restarting the ROS daemon on every wrapped
# call leaves every other terminal blind for ~10 s each time
# (CHANGELOG_2026-09-08.md §2).
#
# Simulation and hardware need OPPOSITE settings and each fails SILENTLY under
# the other's -- no error, just an empty topic list. Never mix them.

# shellcheck source=./paths.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/paths.sh"

# `|| true` so a missing ROS install cannot abort a caller that uses `set -e`
# (the Makefile and the container entrypoints do). The warning still prints.
vla_ros_setup || true

# ---- robot address ----------------------------------------------------------
# Override in config/.env if the robot is on a different address.
export VLA_ROBOT_IP="${VLA_ROBOT_IP:-10.42.0.169}"
export VLA_ROBOT_USER="${VLA_ROBOT_USER:-ubuntu}"
export VLA_DISCOVERY_PORT="${VLA_DISCOVERY_PORT:-11811}"

# ---- DDS --------------------------------------------------------------------
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

export ROS_DOMAIN_ID=0
# The robot's own nodes are on domain 0, so this must be 0. The simulation is
# deliberately left on the default domain; isolation between the two comes from
# the discovery-server variables below, not from the domain (see sim.env).

export FASTRTPS_DEFAULT_PROFILES_FILE="${VLA_FASTDDS_PROFILE:-$VLA_CONFIG_DIR/fastdds_hw_wifi_only.xml}"
# Forces Fast DDS into SUPER CLIENT mode, i.e. it takes its whole view of the
# network from the discovery server, plus an interface whitelist so DDS traffic
# cannot leak onto another interface (CHANGELOG_2026-09-11.md).
#
# BOTH this and ROS_DISCOVERY_SERVER are required, together. Sourcing
# /etc/turtlebot4_discovery/setup.bash alone is not enough: it sets
# ROS_SUPER_CLIENT=True only when a terminal is attached, so in any `bash -c`
# wrapper you get a plain client that receives topic data but no discovery
# directory -- which looks exactly like an empty topic list.

export ROS_DISCOVERY_SERVER="${VLA_ROBOT_IP}:${VLA_DISCOVERY_PORT};"
# The trailing semicolon is REQUIRED: it terminates the server list, and
# Fast DDS mis-parses the entry without it.

# ---- project ----------------------------------------------------------------
export VLA_NS="${VLA_NS:-/robot1}"
# The real robot runs everything under /robot1 (agent #37).

unset VLA_RAW_RGB
# Re-enable compressed RGB (#50): 187 kB -> ~10 kB per frame. Raw frames over
# the Wi-Fi link are what made depth collapse to one frame every twenty seconds.

unset VLA_RAW_DEPTH
# Re-enable compressedDepth (#51), same reason.
