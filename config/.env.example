# config/.env.example -- copy to config/.env and edit. config/.env is git-ignored.
#
#   cp config/.env.example config/.env
#
# Everything here has a working default, so an empty config/.env is fine. Set a
# value only to override. config/paths.sh reads this file automatically, before
# sim.env or robot.env apply their own defaults.
#
# Shell syntax: KEY=value, no spaces around '='. It is sourced, so quote values
# containing spaces.

# ---- locations --------------------------------------------------------------
# Repository root. Resolved automatically from config/paths.sh; set it only if
# you run the scripts through a symlink that confuses that resolution.
#VLA_ROOT=/path/to/AI-guided-Ground-Operation-robot-using-VLA

# Where logs are written. Default: $VLA_ROOT/logs
#VLA_LOG_DIR=/var/log/vla

# Where model weights live. Default: $VLA_ROOT/models
# These total ~2.4 GB, so a shared location outside the repo is often better.
# scripts/download_models.sh fills this directory and checks every sha256.
#VLA_MODEL_DIR=/srv/models/vla

# ---- the robot --------------------------------------------------------------
# Address of the Raspberry Pi running the discovery server.
#VLA_ROBOT_IP=10.42.0.169
#VLA_ROBOT_USER=ubuntu
#VLA_DISCOVERY_PORT=11811

# ROS namespace. The hardware runs everything under /robot1; the simulation
# uses an EMPTY namespace. Do not set this to empty for hardware.
#VLA_NS=/robot1

# ---- ROS / DDS --------------------------------------------------------------
# Path to the ROS setup script, if not the usual one.
#VLA_ROS_SETUP=/opt/ros/humble/setup.bash

# Fast DDS profile for hardware. Default: $VLA_CONFIG_DIR/fastdds_hw_wifi_only.xml
# The default carries the interface whitelist; fastdds_super_client.xml is the
# older profile without it.
#VLA_FASTDDS_PROFILE=/path/to/fastdds_hw_wifi_only.xml

# ---- models / services ------------------------------------------------------
# Ollama endpoint and model. The digest is checked by scripts/download_models.sh.
#VLA_OLLAMA_HOST=http://127.0.0.1:11434
#VLA_OLLAMA_MODEL=qwen2.5:7b

# Whisper model for transcription. medium.en is the one used; small.en mishears
# accented English.
#VLA_WHISPER=medium.en
#VLA_MIC=pulse
#VLA_MIN_LOGPROB=-0.75

# ---- agent behaviour (hardware only; defaults are the simulation's) ---------
# These are documented in src/README.md. Changing them changes robot behaviour,
# so leave them alone unless you know why. Listed here so they are discoverable.
#VLA_RGB_ONLY=1            # camera is colour-only on hardware
#VLA_ARRIVE_TOL=0.50       # must exceed largest standoff + 0.25 - stop
#VLA_MIN_FRONT_CLEAR=0.35  # metres of front clearance required
#VLA_STOP_DISTANCE=0.60    # 0.45 fails: inside Nav2's 0.45 m inflation
#VLA_STANDOFFS=0.60,0.80
#VLA_ARRIVE_IF_SEEN_M=1.2
#VLA_ANNOT_PERIOD=0.033    # 30 Hz annotated stream for the GUI

# ---- camera stream ----------------------------------------------------------
#VLA_CAM_FPS=30            # 0 skips the camera-bandwidth stage entirely
#VLA_CAM_JPEG=75
#VLA_CAM_PX=512            # do not go below 416: far/occluded chairs stop scoring
